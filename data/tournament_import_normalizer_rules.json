{
  "version": "1.0",
  "description": "Rules to normalize raw tournament labels before team identity creation.",
  "strip_prefix_patterns": [
    "^\\s*\\d+\\s+",
    "^\\s*(?:1st|2nd|3rd|4th)\\s+in\\s+[a-z]\\s+",
    "^\\s*(?:1st|2nd|3rd|4th)\\s*in\\s*[a-z]\\s+",
    "^\\s*(?:1st|2nd|3rd|4th)[a-z]\\s+",
    "^\\s*(?:1st|2nd|3rd|4th)[a-z]?\\s+",
    "^\\s*(?:1sta|1stb|1stc|1std|1ste|1stf|1stg|1sth|1stk|1stp)\\s+",
    "^\\s*(?:2nda|2ndb|2ndc|2ndd|2nde|2ndf|2ndg|2ndh|2ndr|2nds)\\s+",
    "^\\s*(?:3rda|3rdb|3rdc|3rdd|3rde|3rdf|3rdg|3rdh|3rdj|3rdk|3rdm|3rdq|3rds)\\s+",
    "^\\s*(?:4tha|4thb|4thc|4thd|4the|4thf|4thg|4thh)\\s+",
    "^\\s*(?:win|winner|los|loser|loss)\\s+gm\\s+#?\\d+\\s*[-\u2013]\\s*",
    "^\\s*(?:win|winner|los|loser|loss)\\s+game\\s+#?\\d+\\s*[-\u2013]\\s*"
  ],
