    {
      "id": "shootout_miss",
      "label": "Shootout miss",
      "category": "shootout",
      "requiresPlayer": "team-dependent",
      "allowsAssist": false,
      "teamScoreDelta": 0,
      "opponentScoreDelta": 0,
      "groupMePriority": "major",
      "autoSubmit": true
