  "mobileWorkflow": {
    "activeGameFields": [
      "time_remaining",
      "event",
      "player",
      "goal_assist",
      "optional_note",
      "submit"
    ],
    "progressiveDisclosure": true,
    "timelineCollapsedDuringPlay": true,
    "setupHiddenDuringPlay": true,
    "postSubmitFocus": "time_remaining",
    "instantSubmit": true,
    "confirmationStep": false,
    "endQuarterAdvancesFlow": true,
    "reusePreviousGameStartingLineup": true,
    "submitLabel": "Submit play",
    "postSubmitReset": [
      "event",
      "player",
      "assist",
      "optional_note"
    ],
    "postSubmitPreserve": [
      "time_remaining",
      "quarter"
    ],
    "endQuarterClock": "0:00",
    "quarterStartRequiresLineupFirst": true,
    "teamSpecificRoster": true,
    "addPlayerEnabled": true,
    "resetTestGame": {
      "availableStates": [
        "setup",
        "live",
        "between_quarters",
        "ended"
      ],
      "clears": [
        "score",
        "quarter",
        "time_remaining",
        "events",
        "timeline",
        "recap",
        "mock_groupme_log"
      ],
      "preserves": [
        "team_setup",
        "roster",
        "default_starting_lineup"
      ],
      "returnsTo": "pregame_setup"
    },
    "sectionHeading": "Time of play",
    "notesExpandedByDefault": true,
    "endQuarterPlacement": "below_submit",
    "endQuarterPresentation": "compact_secondary",
    "activityPanelsAutoOpen": [
      "groupme_play_log",
      "game_timeline"
    ],
    "manualControlsLabel": "Manual controls",
    "manualControlsCollapsedByDefault": true,
    "endGamePlacement": "manual_controls_before_activity_logs",
    "postQ4Flow": [
      "end_game",
      "start_overtime",
      "start_shootout"
    ],
    "overtimeLengthsMinutes": [
      1,
      2,
      3
    ],
    "overtimeAllowsAdditionalPeriods": true,
    "shootout": {
      "selectFirstTeam": true,
      "alternatingAttempts": true,
      "ourShooterSource": "team_roster",
      "opponentShooterSource": "manual_player_or_cap",
      "outcomes": [
        "goal",
        "miss"
      ],
      "autoSubmitOutcome": true,
      "undoLastShot": true,
      "endGameAnyTime": true,
      "scoreIncrementPerGoal": 0.1,
      "scoreExample": "10-10 becomes 10.1-10 after the first successful attempt"
    },
    "overtimeFormats": [
      "single_period",
      "multiple_periods_or_halves"
    ],
    "shotTracking": {
      "nonGoalOutcomes": [
        "missed_goal",
        "off_post",
        "blocked_in_play",
        "saved_by_goalie"
      ],
      "allOutcomesTrackOurShooter": true,
      "offensiveEventIds": [
        "shot_missed",
        "shot_post",
        "shot_blocked",
        "shot_saved"
      ],
      "opponentDefensiveCredits": {
        "blocked_in_play": "records one opponent field block at team level while crediting our shooter with the attempt",
        "saved_by_goalie": "records one opposing-goalie save at team level while crediting our shooter with the attempt"
      },
      "separateOurDefenseEvents": [
        "field_block",
        "save"
      ]
    }
  },
  "lineupRules": {
    "10U": {
      "goalies": 1,
      "fieldPlayers": 5,
      "totalStarters": 6
    },
    "12U": {
      "goalies": 1,
      "fieldPlayers": 5,
      "totalStarters": 6
    },
    "14U": {
      "goalies": 1,
      "fieldPlayers": 6,
      "totalStarters": 7
    },
    "16U": {
      "goalies": 1,
      "fieldPlayers": 6,
      "totalStarters": 7
    },
    "18U": {
      "goalies": 1,
      "fieldPlayers": 6,
      "totalStarters": 7
    }
  },
  "pilotTeam": "Lamorinda A 14U Boys",
  "connectedBackend": {
    "status": "foundation_ready",
    "auth": [
      "email_password",
      "email_confirmation",
      "password_reset"
    ],
    "roles": [
      "owner",
      "admin",
      "scorer",
      "viewer"
    ],
    "storage": [
      "teams",
      "members",
      "rosters",
      "players",
      "games",
      "lineups",
      "events",
      "deliveries",
      "recaps"
    ],
    "realtimeTables": [
      "live_games",
      "live_events",
      "live_lineups"
    ],
    "localFallback": true,
    "groupMeDelivery": "mock_until_7.56.2"
  },
  "groupMeDelivery": {
    "mode": "authenticated_edge_function",
    "provider": "groupme",
    "storeBeforeSend": true,
    "testMessage": true,
    "retryScheduleSeconds": [
      60,
      300,
      900,
      3600
    ],
    "manualRetry": true,
    "attemptAudit": true,
    "secretStorage": "supabase_edge_function_environment"
  },
  "scorerControl": {
    "mode": "one_active_scorer_per_game",
    "guestHandoff": true,
    "qrGeneratedLocally": true,
    "fallbackCodeDigits": 6,
    "passLifetimeSeconds": 300,
    "singleUse": true,
    "noPermanentAccountRequired": true,
    "previousScorerReadOnlyAfterAcceptance": true,
    "adminTakeover": true,
    "auditHistory": true
  }
}
