    },
    {
      "id": "five_meter_committed",
      "label": "5m called on",
      "category": "penalties",
      "requiresPlayer": true,
      "allowsAssist": false,
      "groupMePriority": "major",
      "dropdownLabel": "5m called on \u2014 our player committed it"
    },
    {
      "id": "quarter_start",
      "label": "Quarter start",
      "category": "game",
      "requiresPlayer": false,
