    },
    {
      "id": "shot_saved",
      "label": "Shot saved by opponent goalie",
      "category": "shots",
      "requiresPlayer": true,
      "allowsAssist": false,
      "teamShotDelta": 1,
      "opponentSaveDelta": 1,
      "groupMePriority": "all",
      "dropdownLabel": "Shot saved by opponent goalie \u2014 our team",
      "playerLabel": "Shooter"
    },
    {
      "id": "field_block",
      "label": "Field block",
      "category": "defense",
      "requiresPlayer": true,
      "allowsAssist": false,
