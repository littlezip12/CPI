      "dropdownLabel": "Steal"
    },
    {
      "id": "turnover",
      "label": "Turnover",
      "category": "possession",
      "requiresPlayer": true,
      "allowsAssist": false,
      "groupMePriority": "all",
      "dropdownLabel": "Turnover"
    },
    {
      "id": "exclusion_drawn",
      "label": "Exclusion drawn",
