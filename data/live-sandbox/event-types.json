{
  "schemaVersion": 10,
  "release": "7.56.7",
  "environment": "sandbox",
  "entryModel": "guided_dropdown",
  "eventTypes": [
    {
      "id": "goal",
      "label": "Goal",
      "category": "scoring",
      "requiresPlayer": true,
      "allowsAssist": true,
      "assistDefault": "unassisted",
      "teamScoreDelta": 1,
      "groupMePriority": "major",
      "dropdownLabel": "Goal \u2014 our team",
      "teamShotDelta": 1
    },
    {
      "id": "opponent_goal",
      "label": "Opponent goal",
      "category": "scoring",
      "requiresPlayer": false,
      "allowsAssist": false,
      "opponentScoreDelta": 1,
      "groupMePriority": "major",
      "dropdownLabel": "Goal \u2014 opponent",
      "opponentShotDelta": 1
    },
    {
