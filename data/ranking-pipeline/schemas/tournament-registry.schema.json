{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPI Tournament Registry Entry",
  "type": "object",
  "required": ["tournamentId", "name", "season", "startDate", "status", "rankingWeightClass"],
  "properties": {
    "tournamentId": { "type": "string" },
    "name": { "type": "string" },
    "season": { "type": "string" },
    "startDate": { "type": "string", "format": "date" },
    "endDate": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["planned", "collected", "parsed", "reviewed", "published"] },
    "rankingWeightClass": { "type": "string", "enum": ["juniorOlympics", "futuresSuperFinals", "usClubChampionships", "joQualifiers", "majorInvitational", "earlySeason"] },
    "sourceFiles": { "type": "array", "items": { "type": "string" } },
    "sourceUrls": { "type": "array", "items": { "type": "string" } },
    "groupsIncluded": { "type": "array", "items": { "type": "string" } },
    "divisionLabels": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
