{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPI Alias Correction Checklist",
  "type": "object",
  "required": [
    "groupKey",
    "aliasReviewItems"
  ],
  "properties": {
    "templateName": {
      "const": "alias-correction-checklist"
    },
    "release": {
      "type": "string"
    },
    "groupKey": {
      "type": "string"
    },
    "aliasReviewItems": {
      "type": "array"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
