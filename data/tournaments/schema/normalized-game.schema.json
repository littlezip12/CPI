{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://littlezip12.github.io/CPI/data/tournaments/schema/normalized-game.schema.json",
  "title": "CPI normalized tournament dataset",
  "type": "object",
  "required": [
    "schemaVersion",
    "release",
    "identityRelease",
    "event",
    "division",
    "source",
    "counts",
    "games"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "release": {
      "type": "string"
    },
    "identityRelease": {
      "type": "string"
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ]
    },
    "division": {
      "type": "object",
      "required": [
        "id",
        "season",
        "ageGroup",
        "gender",
        "division",
        "parser"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "spreadsheetId",
        "gid",
        "url",
        "fetchedAt",
        "mode",
        "contentSha256",
        "rowCount"
      ]
    },
    "games": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/game"
      }
    }
  },
  "$defs": {
    "participant": {
      "type": "object",
      "required": [
        "raw",
        "kind",
        "seed",
        "sourceReference",
        "displayName",
        "teamId",
        "clubId",
        "identityStatus",
        "identityMatchType"
      ],
      "properties": {
        "kind": {
          "enum": [
            "empty",
            "team",
            "bracket_reference",
            "placeholder"
          ]
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "teamId": {
          "type": [
            "string",
            "null"
          ]
        },
        "clubId": {
          "type": [
            "string",
            "null"
          ]
        },
        "identityMatchType": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "game": {
      "type": "object",
      "required": [
        "id",
        "eventId",
        "divisionId",
        "season",
        "ageGroup",
        "gender",
        "division",
        "sourceRow",
        "status",
        "participants",
        "scores",
        "outcome",
        "advancement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^game-[a-z0-9-]+$"
        },
        "sourceRow": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "scheduled",
            "final"
          ]
        },
        "participants": {
          "type": "object",
          "required": [
            "white",
            "dark"
          ],
          "properties": {
            "white": {
              "$ref": "#/$defs/participant"
            },
            "dark": {
              "$ref": "#/$defs/participant"
            }
          }
        }
      }
    }
  }
}
