#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

echo "CPI Static Build"
echo "================"

# Do not overwrite the logo registry from an empty source directory.
if find assets-original/logos -maxdepth 1 -type f 2>/dev/null | grep -q .; then
  python3 scripts/build-logos.py
else
  echo "Skipped logo rebuild: assets-original/logos contains no source files."
  echo "Existing logo registry and deployed logo paths were preserved."
fi

python3 scripts/build-club-pages.py
python3 scripts/validate-club-pages.py
./release-check

echo
echo "CPI static build completed."
